# Server-side only. Never prefix with VITE_ — anything VITE_-prefixed is
# inlined into the browser bundle and would leak the key publicly.
GEMINI_API_KEY=your-key-here

# Optional: override the model without a code change.
# GEMINI_MODEL=gemini-3.7-flash

# Optional, local development only. When true, a Gemini failure returns a
# LOCAL, NON-AI review labelled "dev-fallback" instead of an error. Never set
# this in production — it would hide a broken AI pipeline.
# ALLOW_DEV_FALLBACK=true
