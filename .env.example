# ─────────────────────────────────────────────────────────────────────────────
# Pick ONE backend. Both are server-side only — never prefix either with VITE_,
# because anything VITE_-prefixed is inlined into the browser bundle and would
# publish the credential.
# ─────────────────────────────────────────────────────────────────────────────

# A) Gemini API — one key, the simpler setup.
GEMINI_API_KEY=

# B) Vertex AI — the same models, authenticated with a Google Cloud service
#    account instead of a key. Use this if AI Studio only issues keys starting
#    "AQ." for your account: the Gemini API currently rejects those with 401
#    however they are sent, and no client-side change fixes it.
#
#    Paste the whole service-account JSON key file on one line (or its base64
#    encoding, if the dashboard mangles multi-line values). Setting this makes
#    the app use Vertex and ignore GEMINI_API_KEY.
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...",...}
#
#    Optional — defaults to the project_id inside the key, and to "global",
#    which is where Vertex serves the newest models.
# GOOGLE_CLOUD_PROJECT=my-project-id
# GOOGLE_CLOUD_LOCATION=global

# Optional: override the model without a code change.
# GEMINI_MODEL=gemini-3.7-flash

# Optional, local development only. When true, a generation failure returns a
# LOCAL, NON-AI review labelled "dev-fallback" instead of an error. Never set
# this in production — it would hide a broken AI pipeline.
# ALLOW_DEV_FALLBACK=true
